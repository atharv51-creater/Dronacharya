[Unit]
Description=Dronacharya Multi-Agent Economy Gateway & Services
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/dronacharya
Environment=NODE_ENV=production
Environment=PORT=8080
Environment=GATEWAY_PORT=8080
Environment=REGISTRY_ALLOW_LOOPBACK=true
Environment=BUYER_ALLOW_LOOPBACK=true
EnvironmentFile=-/opt/dronacharya/.env
ExecStart=/usr/bin/npm start
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
