# Frontend env. Only VITE_* values reach the browser, so never put secrets here.
# The browser reads exactly two: VITE_API_BASE_URL and VITE_GOOGLE_CLIENT_ID.

# Where the browser sends API calls. Leave EMPTY in development (Vite proxy, below) and in
# production when the gateway serves the built UI from the same origin (the default).
VITE_API_BASE_URL=

# Google OAuth client ID (public by design; the server checks it as GOOGLE_CLIENT_ID).
# Empty -> the header shows "Sign-in not configured".
VITE_GOOGLE_CLIENT_ID=

# ---- Dev proxy target (read by vite.config.ts only, never sent to the browser) ----
# The backend gateway from `npm run start:all`. Default: http://localhost:8080
DEV_API_TARGET=
# The buyer agent, for /api/tasks and /api/auth/mode in dev (local mode). Default: http://localhost:4200
DEV_BUYER_URL=
