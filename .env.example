# Copy to .env (git-ignored) or run `npm run wallets:new`, which creates .env and fills in fresh
# testnet wallets for you. TESTNET ONLY: the network is hard-coded to Base Sepolia (eip155:84532).

# --- Network (informational; services refuse to start unless the RPC reports chain id 84532) ---
RPC_URL=https://sepolia.base.org
FACILITATOR_URL=https://x402.org/facilitator

# --- Registry ---
REGISTRY_PORT=4000
REGISTRY_URL=http://localhost:4000
# Shared secret our own sellers use to upsert their listings. Public registrations are insert-only.
REGISTRY_ADMIN_TOKEN=
# Allow http://localhost endpoints in listings (dev). Public endpoints must be https either way.
REGISTRY_ALLOW_LOOPBACK=true

# --- Seller payTo addresses (PUBLIC; sellers hold no private keys, the facilitator pays gas) ---
SCRAPER_PAY_TO=
DATA_PAY_TO=
INFERENCE_PAY_TO=
CHAOS_PAY_TO=
# Second address the chaos seller's wrong-payto fixture advertises instead of its listed payTo.
CHAOS_ALT_PAY_TO=
# Seller guild (apps/sellers/guild): 11 more sellers, one wallet each. `npm run wallets:new` fills these.
RICH_SHELF_PAY_TO=
BOOK_INSPECTOR_PAY_TO=
FX_GLOBAL_PAY_TO=
FX_TREND_PAY_TO=
NVIDIA_HINDI_PAY_TO=
OPENROUTER_HINDI_PAY_TO=
INDIC_TRANSLATOR_PAY_TO=
SENTIMENT_TAGGER_PAY_TO=
TEXT_INSIGHTS_PAY_TO=
PRICE_ADVISOR_PAY_TO=
LISTING_AUDITOR_PAY_TO=

# --- Public URLs ---
# Set all of these at once with: npm run deploy:configure -- https://<public-host>
# A URL with a path (https://host/scraper) serves that service under the path, behind the gateway.
REGISTRY_PUBLIC_URL=http://localhost:4000
BUYER_PUBLIC_URL=http://localhost:4200
# Gateway: one port for every service (put your tunnel in front of it)
GATEWAY_PORT=8080
# Public RPC limits eth_getLogs to 200 blocks per call; a paid RPC can raise this
RPC_LOGS_MAX_RANGE=200
# Etherscan V2 API key (one key covers Base Sepolia, chainid 84532). Optional; server-side only.
ETHERSCAN_API_KEY=

# --- Seller ports and public URLs (set PUBLIC_URLs to your https tunnel hostnames for judging) ---
SCRAPER_PORT=4101
SCRAPER_PUBLIC_URL=http://localhost:4101
DATA_PORT=4102
DATA_PUBLIC_URL=http://localhost:4102
INFERENCE_PORT=4103
INFERENCE_PUBLIC_URL=http://localhost:4103
CHAOS_PORT=4199
CHAOS_PUBLIC_URL=http://localhost:4199
# Seller guild: ports are GUILD_BASE_PORT + position (4111-4121); GUILD_SELLERS=a,b runs only some.
GUILD_BASE_PORT=4111
GUILD_SELLERS=
RICH_SHELF_PUBLIC_URL=http://localhost:4111
BOOK_INSPECTOR_PUBLIC_URL=http://localhost:4112
FX_GLOBAL_PUBLIC_URL=http://localhost:4113
FX_TREND_PUBLIC_URL=http://localhost:4114
NVIDIA_HINDI_PUBLIC_URL=http://localhost:4115
OPENROUTER_HINDI_PUBLIC_URL=http://localhost:4116
INDIC_TRANSLATOR_PUBLIC_URL=http://localhost:4117
SENTIMENT_TAGGER_PUBLIC_URL=http://localhost:4118
TEXT_INSIGHTS_PUBLIC_URL=http://localhost:4119
PRICE_ADVISOR_PUBLIC_URL=http://localhost:4120
LISTING_AUDITOR_PUBLIC_URL=http://localhost:4121

# --- Gemini (inference seller's Hindi text; buyer's task parser and narrative) ---
# Get a key at https://aistudio.google.com/apikey. Without it, /summarise answers 503 (never charged)
# and the buyer reads tasks with its rules parser.
GEMINI_API_KEY=
SUMMARY_MODEL=gemini-3.5-flash-lite
# Optional: low | medium | high (Gemini 3.x thinking level; leave empty for the model default)
GEMINI_THINKING=

# --- OpenAI-compatible LLM providers for guild sellers (SECRET, server-side only) ---
# NVIDIA NIM (https://build.nvidia.com): nvidia-hindi, sentiment-tagger
NVIDIA_API_KEY=
# Tried in order; the next model is used when one is overloaded, rate-limited or slow.
NVIDIA_MODELS=nvidia/nemotron-3-ultra-550b-a55b,nvidia/nemotron-3-super-120b-a12b
# OpenRouter (https://openrouter.ai): openrouter-hindi, indic-translator, listing-auditor's AI review
OPENROUTER_API_KEY=
OPENROUTER_MODELS=deepseek/deepseek-v4-flash,mistralai/mistral-small-3.2-24b-instruct

# --- Buyer (SECRET, testnet only: only the buyer signs payments) ---
BUYER_PRIVATE_KEY=
BUYER_SPARE_PRIVATE_KEY=

# --- Buyer agent (port 4200) ---
BUYER_PORT=4200
# Required for remote POSTs (tasks spend the buyer's USDC). Requests from this machine are allowed without it.
# The gateway also uses it server-side to forward Scout runs from signed-in, allow-listed users. Never put it in the frontend.
BUYER_API_TOKEN=
BUYER_ALLOW_LOOPBACK=true
# Largest budget one task may be given.
BUYER_MAX_TASK_BUDGET=0.50
# Task parsing and narrative: auto (Gemini when GEMINI_API_KEY is set, else rules) | off (rules only)
BUYER_LLM_PARSER=auto
BUYER_MODEL=gemini-3.5-flash-lite

# --- Web UI sign-in (server-side; the gateway serves the UI and checks these) ---
# Google OAuth client ID used as the ID-token audience. Unset -> every Google sign-in is refused.
# (The same public value goes in dronacharya-frontend/.env as VITE_GOOGLE_CLIENT_ID.)
GOOGLE_CLIENT_ID=
# Comma-separated, verified Google emails. Empty by default: nobody can run Scout from the UI.
SCOUT_ALLOWED_EMAILS=
ADMIN_EMAILS=
# Most USDC one signed-in email may commit to Scout tasks per UTC day (gateway-enforced).
SCOUT_DAILY_CAP_USDC=0.20
# Built UI the gateway serves (default dronacharya-frontend/dist). Build with: npm run build:frontend
FRONTEND_DIST=

# --- Misc ---
LOG_LEVEL=info
