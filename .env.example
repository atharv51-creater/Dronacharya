# Copy to .env (git-ignored) or run `npm run wallets:new`, which creates .env and fills in fresh
# testnet wallets for you. TESTNET ONLY: the network is hard-coded to Base Sepolia (eip155:84532).

# --- Network (informational; services refuse to start unless the RPC reports chain id 84532) ---
RPC_URL=https://sepolia.base.org
FACILITATOR_URL=https://x402.org/facilitator

# --- Registry ---
REGISTRY_PORT=4000
REGISTRY_URL=http://localhost:4000
# Shared secret our own sellers use to upsert their listings. Public registrations are insert-only.
REGISTRY_ADMIN_TOKEN=
# Allow http://localhost endpoints in listings (dev). Public endpoints must be https either way.
REGISTRY_ALLOW_LOOPBACK=true

# --- Seller payTo addresses (PUBLIC; sellers hold no private keys, the facilitator pays gas) ---
SCRAPER_PAY_TO=
DATA_PAY_TO=
INFERENCE_PAY_TO=
CHAOS_PAY_TO=
# Second address the chaos seller's wrong-payto fixture advertises instead of its listed payTo.
CHAOS_ALT_PAY_TO=

# --- Public URLs ---
# Set all of these at once with: npm run deploy:configure -- https://<public-host>
# A URL with a path (https://host/scraper) serves that service under the path, behind the gateway.
REGISTRY_PUBLIC_URL=http://localhost:4000
BUYER_PUBLIC_URL=http://localhost:4200
# Gateway: one port for every service (put your tunnel in front of it)
GATEWAY_PORT=8080
# Public RPC limits eth_getLogs to 200 blocks per call; a paid RPC can raise this
RPC_LOGS_MAX_RANGE=200

# --- Seller ports and public URLs (set PUBLIC_URLs to your https tunnel hostnames for judging) ---
SCRAPER_PORT=4101
SCRAPER_PUBLIC_URL=http://localhost:4101
DATA_PORT=4102
DATA_PUBLIC_URL=http://localhost:4102
INFERENCE_PORT=4103
INFERENCE_PUBLIC_URL=http://localhost:4103
CHAOS_PORT=4199
CHAOS_PUBLIC_URL=http://localhost:4199

# --- Gemini (inference seller's Hindi text; buyer's task parser and narrative) ---
# Get a key at https://aistudio.google.com/apikey. Without it, /summarise answers 503 (never charged)
# and the buyer reads tasks with its rules parser.
GEMINI_API_KEY=
SUMMARY_MODEL=gemini-3.5-flash-lite
# Optional: low | medium | high (Gemini 3.x thinking level; leave empty for the model default)
GEMINI_THINKING=

# --- Buyer (SECRET, testnet only: only the buyer signs payments) ---
BUYER_PRIVATE_KEY=
BUYER_SPARE_PRIVATE_KEY=

# --- Buyer agent (port 4200) ---
BUYER_PORT=4200
# Required for remote POSTs (tasks spend the buyer's USDC). Requests from this machine are allowed without it.
BUYER_API_TOKEN=
BUYER_ALLOW_LOOPBACK=true
# Largest budget one task may be given.
BUYER_MAX_TASK_BUDGET=0.50
# Task parsing and narrative: auto (Gemini when GEMINI_API_KEY is set, else rules) | off (rules only)
BUYER_LLM_PARSER=auto
BUYER_MODEL=gemini-3.5-flash-lite

# --- Misc ---
LOG_LEVEL=info
